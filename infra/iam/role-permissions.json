{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeMumbaiResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "ReadProjectInstanceAttributes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstanceAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "ReadProjectVpcAttributes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "CreateTaggedNetworkAndNamedKey",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:ImportKeyPair"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:key-pair/campusops-operator"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "CreateChildrenInProjectVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "AttachOrDetachProjectGateway",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "ManageProjectRoutes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "ManageProjectGroupRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "AuthorizeTaggedRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "UpdateAndRevokeTaggedRules",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifySecurityGroupRules",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "LaunchReviewedUbuntuImage",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1::image/UBUNTU_AMI_ID"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "LaunchInProjectNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:key-pair/campusops-operator"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "AllowLaunchNetworkInterface",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "LaunchTaggedMicroWithImdsv2",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/Project": "CampusOps",
          "ec2:InstanceType": "t3.micro",
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "LaunchTaggedEncryptedRootVolume",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/Project": "CampusOps",
          "ec2:VolumeType": "gp3"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "10"
        }
      }
    },
    {
      "Sid": "BootstrapProjectTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group-rule/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:key-pair/campusops-operator",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:RequestTag/Project": "CampusOps",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateInternetGateway",
            "CreateRouteTable",
            "CreateSecurityGroup",
            "ImportKeyPair",
            "AuthorizeSecurityGroupIngress",
            "AuthorizeSecurityGroupEgress",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "EditNonBoundaryTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group-rule/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:key-pair/campusops-operator",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Name",
            "Role",
            "ManagedBy"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    },
    {
      "Sid": "ConfigureProjectNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:ModifySubnetAttribute"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "OperateProjectInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    },
    {
      "Sid": "DeleteProjectResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:DeleteSecurityGroup",
        "ec2:DeleteInternetGateway",
        "ec2:DeleteVolume",
        "ec2:DeleteKeyPair"
      ],
      "Resource": [
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:vpc/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:route-table/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:internet-gateway/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:volume/*",
        "arn:aws:ec2:ap-south-1:ACCOUNT_ID:key-pair/campusops-operator"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-south-1",
          "aws:ResourceTag/Project": "CampusOps"
        }
      }
    }
  ]
}
